# Shell scripts run on Linux servers and in containers: CRLF would break them.
*.sh text eol=lf

# Evidence fixtures must stay byte-identical: line numbers and hashes depend on it.
tests/fixtures/** -text
benchmark/scenarios/** -text
benchmark/external/** -text

# Lab files are mounted into Linux containers.
lab/** text eol=lf

# Golden reports are compared byte for byte.
tests/golden/** -text
