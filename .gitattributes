# Shell scripts run on Linux servers and in containers: CRLF would break them.
*.sh text eol=lf

# Evidence fixtures must stay byte-identical: line numbers and hashes depend on it.
tests/fixtures/** -text
benchmark/scenarios/** -text
benchmark/external/** -text
benchmark/v2/** -text

# Lab files are mounted into Linux containers.
lab/** text eol=lf

# Golden reports are compared byte for byte.
tests/golden/** -text

# The example viewer is compared byte for byte with a fresh render.
docs/examples/** -text

# The viewer embeds these files and hashes the script for its CSP: keep the bytes the same
# on every platform.
src/webforensics/report/viewer_assets/** text eol=lf
