<!--
  webforensics write-back rules (M6+, D92).
  Install: copy to /var/ossec/etc/rules/ on the Wazuh manager and restart it.
  Events arrive through the analysisd queue (`webforensics writeback` or the
  custom-webforensics integration), are decoded by the built-in JSON decoder and
  carry "integration": "webforensics". IDs 100800-100809 are in the custom range.
-->
<group name="webforensics,">

  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^webforensics$</field>
    <description>webforensics: write-back event.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100801" level="12">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^summary$</field>
    <field name="webforensics.compromised">^yes$</field>
    <field name="webforensics.root_cause_found">^yes$</field>
    <description>webforensics: website compromise reconstructed, entry $(webforensics.root_cause.method) $(webforensics.root_cause.path) ($(webforensics.root_cause.vuln_class), confidence $(webforensics.root_cause.confidence)), $(webforensics.affected_files) affected file(s), case $(webforensics.case_id).</description>
    <options>no_full_log</options>
    <group>webforensics_summary,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100802" level="10">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^summary$</field>
    <field name="webforensics.compromised">^yes$</field>
    <field name="webforensics.root_cause_found">^no$</field>
    <description>webforensics: website compromise found, entry point unknown, $(webforensics.affected_files) affected file(s), case $(webforensics.case_id).</description>
    <options>no_full_log</options>
    <group>webforensics_summary,</group>
  </rule>

  <rule id="100803" level="3">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^summary$</field>
    <field name="webforensics.compromised">^no$</field>
    <description>webforensics: analysis found no compromise, case $(webforensics.case_id).</description>
    <options>no_full_log</options>
    <group>webforensics_summary,</group>
  </rule>

  <rule id="100804" level="10">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^affected_file$</field>
    <description>webforensics: affected file $(webforensics.path) ($(webforensics.status)), case $(webforensics.case_id).</description>
    <options>no_full_log</options>
    <group>webforensics_file,</group>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <rule id="100805" level="10">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^attacker_ip$</field>
    <description>webforensics: attacker IP $(webforensics.ip), case $(webforensics.case_id).</description>
    <options>no_full_log</options>
    <group>webforensics_ioc,</group>
  </rule>

  <rule id="100806" level="5">
    <if_sid>100800</if_sid>
    <field name="webforensics.type">^trigger_error$</field>
    <description>webforensics: automatic analysis failed for agent $(webforensics.agent): $(webforensics.error)</description>
    <options>no_full_log</options>
    <group>webforensics_error,</group>
  </rule>

</group>
